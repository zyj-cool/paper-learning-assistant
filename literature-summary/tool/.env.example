# Zotero data directory (find it in Zotero: Edit -> Preferences -> Advanced -> Files and Folders)
ZOTERO_DATA_DIR=

# Output directory for literature summaries
SUMMARY_OUT_ROOT=

# Feishu/Lark app credentials (optional - only needed for Feishu upload)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Feishu target folder token (not the full URL, just the token string)
FEISHU_PARENT_NODE=
FEISHU_PARENT_TYPE=explorer
